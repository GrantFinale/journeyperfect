# Database
DATABASE_URL="postgresql://user:password@host:5432/journeyperfect?sslmode=require"

# Auth
NEXTAUTH_URL="https://www.journeyperfect.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Google Places API (console.cloud.google.com)
# NEXT_PUBLIC_ is used client-side for autocomplete; GOOGLE_PLACES_KEY is used server-side for search
NEXT_PUBLIC_GOOGLE_PLACES_KEY="your-google-places-api-key"
GOOGLE_PLACES_KEY="your-google-places-api-key"

# OpenRouter (openrouter.ai) — all AI features: parsers, optimizer, trip proposals, destination profiles
OPENROUTER_API_KEY="sk-or-v1-..."

# Bearer token the scheduler sends to /api/cron/* routes (flight price re-pricing)
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Private Rates: master key for AES-256-GCM sealing of browser profiles. Lives ONLY on the browser-runner service, never in the Next.js app
PRIVATE_RATES_MASTER_KEY="generate-with-openssl-rand-base64-32"

# Shared secret between the Next.js app and the internal browser-runner service (privateRates.runnerUrl)
BROWSER_RUNNER_SECRET="generate-with-openssl-rand-base64-32"
