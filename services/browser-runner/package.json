{
  "name": "@journeyperfect/browser-runner",
  "version": "0.1.0",
  "private": true,
  "description": "JourneyPerfect private-rates browser runner: isolated Playwright sessions, sealed profiles, live-view sign-in.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "playwright": "1.63.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "typescript": "^5",
    "vitest": "^3.2.1"
  }
}
