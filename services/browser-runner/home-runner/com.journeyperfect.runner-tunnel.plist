<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.journeyperfect.runner-tunnel</string>
  <!-- Reverse tunnel: droplet 10.0.1.1:18787 (coolify network gateway, reachable
       only by Traefik) -> this Mac's 127.0.0.1:8787. See HOME-RUNNER.md. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-n</string>
    <string>-o</string><string>BatchMode=yes</string>
    <string>-o</string><string>StrictHostKeyChecking=yes</string>
    <string>-o</string><string>ServerAliveInterval=30</string>
    <string>-o</string><string>ServerAliveCountMax=3</string>
    <string>-o</string><string>ExitOnForwardFailure=yes</string>
    <string>-o</string><string>ConnectTimeout=15</string>
    <string>-i</string><string>/Users/studio/.ssh/jp_runner_tunnel</string>
    <string>-R</string><string>10.0.1.1:18787:127.0.0.1:8787</string>
    <string>runnertunnel@134.122.113.128</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/studio/journeyperfect-runner/logs/tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/studio/journeyperfect-runner/logs/tunnel.log</string>
</dict>
</plist>
