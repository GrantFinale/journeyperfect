<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.journeyperfect.runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/studio/journeyperfect-runner/home-runner/start.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/studio/journeyperfect-runner</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/Users/studio/journeyperfect-runner/logs/runner.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/studio/journeyperfect-runner/logs/runner.err.log</string>
</dict>
</plist>
